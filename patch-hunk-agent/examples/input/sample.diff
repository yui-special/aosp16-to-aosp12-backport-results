diff --git a/src/session.c b/src/session.c
index 0a1b2c3..4d5e6f7 100644
--- a/src/session.c
+++ b/src/session.c
@@ -6,4 +6,12 @@ int session_lookup(int id)
     return session_table[id];
 }
 
+static int session_token_valid(int token)
+{
+    if (token <= 0) {
+        return 0;
+    }
+    return token != SESSION_TOKEN_INVALID;
+}
+
 void session_refresh(int id)
@@ -11,5 +19,8 @@ void session_refresh(int id)
 void session_refresh(int id)
 {
     int token = session_lookup(id);
+    if (!session_token_valid(token)) {
+        token = SESSION_TOKEN_DEFAULT;
+    }
     store_token(id, token);
 }
