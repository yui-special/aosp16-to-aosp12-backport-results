# Copy to .env and fill in.  Never commit real keys.
#
# .env is loaded automatically by patch_hunk_agent (config.load_env_file): the
# current working directory is checked first, then the repository root.  Real
# environment variables always win over this file.
#
# 最小可用配置:
#   PATCH_HUNK_AGENT_PROVIDER=openai            # 或任意名字（配合下面的端点即可）
#   PATCH_HUNK_AGENT_BASE_URL=<兼容 /chat/completions 的端点>
#   PATCH_HUNK_AGENT_MODEL=<模型名>
#   PATCH_HUNK_AGENT_API_KEY=<你的 key>
#
# 推理型模型（deepseek-flash/reasoner 等）务必加上这一行，否则它会把输出预算
# 全花在隐藏思考上、content 返回空：
PATCH_HUNK_AGENT_REASONING_EFFORT=none

PATCH_HUNK_AGENT_PROVIDER=mock-heuristic
PATCH_HUNK_AGENT_BASE_URL=https://api.openai.com/v1
PATCH_HUNK_AGENT_MODEL=gpt-4o-mini
PATCH_HUNK_AGENT_API_KEY=

# Optional
PATCH_HUNK_AGENT_CONFIG=configs/default.yaml
PATCH_HUNK_AGENT_LOG_LEVEL=INFO
