# Copy to .env and fill in.  Never commit real keys.
#
# .env is loaded automatically by patch_hunk_agent (config.load_env_file): the
# current working directory is checked first, then the repository root.  Real
# environment variables always win over this file.
#
# 最小可用配置（配上 configs/models.yaml 里的 openai provider）:
#   PATCH_HUNK_AGENT_PROVIDER=openai
#   PATCH_HUNK_AGENT_BASE_URL=<兼容 /chat/completions 的端点，例如中转地址>
#   PATCH_HUNK_AGENT_MODEL=<模型名，例如 gpt-4o>
#   PATCH_HUNK_AGENT_API_KEY=<你的 key>
#
# Provider selection for the dependency analyzer.
#   mock            -> scripted/offline responses (tests, CI)
#   mock-heuristic  -> deterministic offline stand-in built from machine evidence
#   openai          -> any OpenAI-compatible /chat/completions endpoint
PATCH_HUNK_AGENT_PROVIDER=deepseek

# OpenAI-compatible endpoint used when PATCH_HUNK_AGENT_PROVIDER=openai
PATCH_HUNK_AGENT_BASE_URL=https://api.deepseek.com
PATCH_HUNK_AGENT_MODEL=deepseek-flash
PATCH_HUNK_AGENT_API_KEY=

